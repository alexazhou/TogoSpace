{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TogoSpace",
  "version": "0.3.12",
  "identifier": "com.togospace.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:8181",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd .. && .venv/bin/python3 tauri/scripts/build_backend.py"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "TogoSpace",
        "url": "splash.html",
        "width": 500,
        "height": 340,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../build/backend": "backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
