{
  "_comment": "TeamAgent 配置文件（v3 格式）。请根据实际 LLM 服务修改。模型 input 字段声明支持的输入类型，缺省即纯文本 ['text']；支持读图的模型配 ['text', 'image']",

  "language": "zh-CN",
  "development_mode": false,
  "bind_host": "0.0.0.0",
  "bind_port": 8180,
  "version": "v3",

  "llm_providers": [
    {
      "name": "deepseek",
      "type": "deepseek",
      "api_key": "YOUR_API_KEY_HERE",
      "enable": false,
      "urls": {
        "openai": "https://api.deepseek.com/v1"
      },
      "models": [
        {
          "name": "deepseek-flash",
          "protocol": "openai",
          "enabled": true,
          "input": ["text", "image"],
          "context_config": {
            "context_window_tokens": 524288
          }
        }
      ]
    },
    {
      "name": "aliyun",
      "type": "aliyun",
      "api_key": "YOUR_API_KEY_HERE",
      "enable": false,
      "urls": {
        "openai": "https://dashscope.aliyuncs.com/compatible-mode/v1"
      },
      "models": [
        {
          "name": "glm-5.3",
          "protocol": "openai",
          "enabled": false,
          "context_config": {
            "context_window_tokens": 524288
          }
        }
      ]
    }
  ],

  "default_models": {
    "primary": "deepseek-flash@deepseek",
    "lite": "",
    "vision": "deepseek-flash@deepseek",
    "advanced": ""
  },

  "context_config": {
    "context_window_tokens": 262144
  },

  "third_party_services": {
    "default_service": {
      "search": "deepseek"
    },
    "deepseek": {
      "enabled": false,
      "api_key": ""
    },
    "xiaomi_mimo": {
      "enabled": false,
      "api_key": ""
    }
  }
}
